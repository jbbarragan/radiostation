#!/usr/bin/liquidsoap
# XHCDMX Radio – radio.liq
set("log.level", 3)
set("log.file", true)
set("log.file.path", "/home/radioadmin/radiostation-fixed/logs/liquidsoap.log")

# Telnet para control remoto (skip, reload, etc.)
set("server.telnet", true)
set("server.telnet.bind_addr", "127.0.0.1")
set("server.telnet.port", 1234)

# ─── Fuentes ───────────────────────────────────────────────────────────────────
backup = mksafe(playlist(
  id="backup",
  mode="random",
  reload=30,
  "/home/radioadmin/radiostation-fixed/backup"
))

scheduled = mksafe(playlist(
  id="scheduled",
  mode="normal",
  reload=0,
  reload_mode="never",
  "/tmp/radio_playlist.m3u"
))

# ─── Lógica de prioridad: show programado > backup ────────────────────────────
radio = fallback(
  id="main_fallback",
  track_sensitive=false,
  [scheduled, backup]
)

# Fader only for scheduled transitions; all existing sources/outputs remain.
# Gain recovers automatically if the scheduler fails mid-transition.
transition_start = ref(-1000.)
transition_duration = ref(2.)
transition_active = ref(false)
def transition_gain()
  elapsed = time() - !transition_start
  if not !transition_active or elapsed > !transition_duration + 8. then
    1.
  else
    max(0., 1. - elapsed / !transition_duration)
  end
end
radio = amplify(transition_gain, radio)
server.register(namespace="radio", description="Fade before a scheduled transition", "fade", fun (arg) -> begin
  transition_duration := max(0.05, float_of_string(default=2., arg))
  transition_start := time()
  transition_active := true
  "OK"
end)
server.register(namespace="radio", description="Restore normal gain", "restore", fun (_) -> begin
  transition_active := false
  "OK"
end)

# ─── Salida Icecast ────────────────────────────────────────────────────────────
output.icecast(
  %mp3(bitrate=128),
  id="icecast_stream",
  host="localhost",
  port=8000,
  password="oL3ydtHXmWg2OVbsmuMhX6zjyCkzTp4J",
  mount="/stream",
  name="XHCDMX Radio",
  description="RadioStation XHCDMX",
  url="https://stream.xhcdmx.org",
  radio
)
